<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.CatalogPage"
             x:TypeArguments="vm:CatalogViewModel"
             x:DataType="vm:CatalogViewModel"
             Title="Items"
             BackgroundColor="{DynamicResource LuxBg}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <Label Grid.Row="0" Text="📦 Item catalog" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <Label Text="No items yet — add products or services to bill faster 📦" TextColor="{DynamicResource LuxTextDim}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CatalogItem">
                    <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="14,10" Margin="0,4">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                <Label FontSize="12" TextColor="{DynamicResource LuxTextDim}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Category}" />
                                            <Span Text="  HSN: " />
                                            <Span Text="{Binding HsnSac}" />
                                            <Span Text="  GST " />
                                            <Span Text="{Binding TaxRate, StringFormat='{0:0.#}%'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                <Label Text="{Binding PriceLabel}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="End" />
                                <Label Text="{Binding StockLabel}" FontSize="11" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="＋ Add New Item" Command="{Binding AddItemCommand}"
                Style="{StaticResource LuxFabButton}" />
    </Grid>
</local:LuxContentPage>
