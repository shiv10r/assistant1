<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             xmlns:views="clr-namespace:LuxInfra.Views"
             xmlns:services="clr-namespace:LuxInfra.Services"
             x:Class="LuxInfra.Views.ChatPage"
             x:Name="Page"
             x:DataType="vm:ChatViewModel"
             Title="Assistant"
             BackgroundColor="{DynamicResource LuxBg}">

    <ContentPage.Resources>
        <DataTemplate x:Key="UserBubble" x:DataType="models:ChatMessage">
            <Grid Padding="60,4,16,4">
                <Border HorizontalOptions="End"
                        Background="{DynamicResource LuxGradient}"
                        StrokeThickness="0"
                        Padding="16,10"
                        MaximumWidthRequest="520">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18,18,4,18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Text}" TextColor="White" FontSize="15" LineBreakMode="WordWrap" />
                        <Label Text="{Binding TimeLabel}" TextColor="{DynamicResource LuxOverlayText}" FontSize="10" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BotBubble" x:DataType="models:ChatMessage">
            <Grid Padding="16,4,60,4" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Grid.Column="0"
                        VerticalOptions="End"
                        WidthRequest="34" HeightRequest="34"
                        Background="{DynamicResource LuxSurface2}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17" />
                    </Border.StrokeShape>
                    <Label Text="✨" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border Grid.Column="1"
                        HorizontalOptions="Start"
                        BackgroundColor="{DynamicResource LuxSurface}"
                        StrokeThickness="0"
                        Padding="16,10"
                        MaximumWidthRequest="520">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18,18,18,4" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Text}" TextColor="{DynamicResource LuxText}" FontSize="15" LineBreakMode="WordWrap" />
                        <Label Text="{Binding TimeLabel}" TextColor="{DynamicResource LuxTextDim}" FontSize="10" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReportBubble" x:DataType="models:ChatMessage">
            <Grid Padding="16,6,24,6" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Grid.Column="0"
                        VerticalOptions="End"
                        WidthRequest="34" HeightRequest="34"
                        Background="{DynamicResource LuxSurface2}"
                        StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                    <Label Text="📒" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border Grid.Column="1"
                        HorizontalOptions="Fill"
                        BackgroundColor="{DynamicResource LuxSurface}"
                        StrokeThickness="0"
                        Padding="0"
                        MaximumWidthRequest="640">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18,18,18,4" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding ReportTitle}" FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource LuxText}" Padding="16,12,16,8" />

                        <!-- table header -->
                        <Grid ColumnDefinitions="*,*,110" Padding="16,8" BackgroundColor="{DynamicResource LuxPrimary}">
                            <Label Text="Site" FontSize="12" FontAttributes="Bold" TextColor="White" />
                            <Label Grid.Column="1" Text="Category" FontSize="12" FontAttributes="Bold" TextColor="White" />
                            <Label Grid.Column="2" Text="Amount" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalOptions="End" />
                        </Grid>

                        <!-- rows -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ReportRow">
                                    <Grid ColumnDefinitions="*,*,110" Padding="16,7">
                                        <Label Text="{Binding Site}" FontSize="13" TextColor="{DynamicResource LuxText}" />
                                        <Label Grid.Column="1" Text="{Binding Category}" FontSize="13" TextColor="{DynamicResource LuxPrimarySoft}" />
                                        <Label Grid.Column="2" Text="{Binding AmountLabel}" FontSize="13" TextColor="{DynamicResource LuxText}" HorizontalOptions="End" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- category totals -->
                        <Label Text="BY CATEGORY" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource LuxTextDim}" Padding="16,10,16,2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoryTotals}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryTotal">
                                    <Grid ColumnDefinitions="*,110" Padding="16,5">
                                        <Label Text="{Binding Category}" FontSize="12" TextColor="{DynamicResource LuxAccent}" />
                                        <Label Grid.Column="1" Text="{Binding TotalLabel}" FontSize="12" TextColor="{DynamicResource LuxText}" HorizontalOptions="End" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- total -->
                        <Grid ColumnDefinitions="*,Auto" Padding="16,10" BackgroundColor="{DynamicResource LuxSurface2}">
                            <Label Text="TOTAL" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                            <Label Grid.Column="1" Text="{Binding TotalLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" />
                        </Grid>

                        <Button Text="📑 Open full report — Excel · PDF · PNG"
                                Command="{Binding BindingContext.OpenReportsCommand, Source={x:Reference Page}}"
                                BackgroundColor="Transparent" TextColor="{DynamicResource LuxAccent}"
                                FontSize="13" HeightRequest="40" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>

        <views:ChatTemplateSelector x:Key="ChatSelector"
                                    UserTemplate="{StaticResource UserBubble}"
                                    BotTemplate="{StaticResource BotBubble}"
                                    ReportTemplate="{StaticResource ReportBubble}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Grid Grid.Column="0">
                    <Image Source="luxinfra_logo.png" WidthRequest="40" HeightRequest="40" />
                    <Label Text="👑" FontSize="15" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-9,-5,0"
                           IsVisible="{Binding IsGold, Source={x:Static services:ProfileService.Instance}, x:DataType={x:Type services:ProfileService}}" />
                </Grid>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label FontSize="20" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Lux" TextColor="{DynamicResource LuxText}" />
                                <Span Text="Infra" TextColor="{DynamicResource LuxAccent}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="your expense bestie 🤝" FontSize="12" TextColor="{DynamicResource LuxTextDim}" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="● online" TextColor="{DynamicResource LuxAccent}" FontSize="12" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Messages -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        ItemTemplate="{StaticResource ChatSelector}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        Margin="0,8" />

        <!-- Quick actions -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Padding="16,4" HorizontalOptions="Center">
            <Button Text="📒 Show report" Command="{Binding QuickSummaryCommand}"
                    BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                    FontSize="13" CornerRadius="16" Padding="14,6" HeightRequest="34" />
            <Button Text="📑 Full report" Command="{Binding OpenReportsCommand}"
                    BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                    FontSize="13" CornerRadius="16" Padding="14,6" HeightRequest="34" />
            <Button Text="📧 Email" Command="{Binding QuickSendCommand}"
                    BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                    FontSize="13" CornerRadius="16" Padding="14,6" HeightRequest="34" />
            <Button Text="💡 Help" Command="{Binding QuickHelpCommand}"
                    BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                    FontSize="13" CornerRadius="16" Padding="14,6" HeightRequest="34" />
        </HorizontalStackLayout>

        <!-- Input -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="16,8,16,16">
            <Border Grid.Column="0" BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Entry Text="{Binding InputText}"
                       Placeholder="site A paint exp = 5k ..."
                       PlaceholderColor="{DynamicResource LuxTextDim}"
                       TextColor="{DynamicResource LuxText}"
                       BackgroundColor="Transparent"
                       ReturnCommand="{Binding SendCommand}"
                       HeightRequest="48" />
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource LuxGradient}" StrokeThickness="0"
                    WidthRequest="48" HeightRequest="48">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendCommand}" />
                </Border.GestureRecognizers>
                <Label Text="➤" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
