<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectTaskPage"
             x:TypeArguments="vm:ProjectTaskViewModel"
             x:DataType="vm:ProjectTaskViewModel"
             Title="Task"
             BackgroundColor="{DynamicResource LuxBg}">


    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="16,12,16,4">
            <Button Style="{StaticResource LuxMenuButton}" Clicked="OnFlyoutMenuClicked" />
            <Button Grid.Column="1" Style="{StaticResource LuxBackButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="2" Text="Task" Style="{StaticResource LuxPageHeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource LuxStatCard}"><VerticalStackLayout Spacing="2"><Label Text="NOT STARTED" Style="{StaticResource LuxStatLabel}" /><Label Text="{Binding NotStartedCount}" Style="{StaticResource LuxStatValue}" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" Style="{StaticResource LuxStatCard}"><VerticalStackLayout Spacing="2"><Label Text="ONGOING" Style="{StaticResource LuxStatLabel}" /><Label Text="{Binding OngoingCount}" Style="{StaticResource LuxStatValue}" /></VerticalStackLayout></Border>
                    <Border Grid.Column="2" Style="{StaticResource LuxStatCard}"><VerticalStackLayout Spacing="2"><Label Text="PROGRESS" Style="{StaticResource LuxStatLabel}" /><Label Text="{Binding OverallProgressLabel}" Style="{StaticResource LuxStatValue}" /></VerticalStackLayout></Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Picker Title="Status" ItemsSource="{Binding TaskStatusOptions}" SelectedItem="{Binding TaskStatusFilter}"
                            TextColor="{DynamicResource LuxText}" TitleColor="{DynamicResource LuxTextDim}" />
                    <Entry Grid.Column="1" Text="{Binding MemberFilter}" Placeholder="Filter by member" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                </Grid>

                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding FilteredTasks}">
                    <BindableLayout.EmptyView>
                        <Label Text="No task added. All task will be listed here" FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectTask">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource LuxSurface2}" StrokeThickness="0" Padding="8,2" VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" />
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" TextColor="{DynamicResource LuxTextDim}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding TaskIdLabel}" /><Span Text=" · " /><Span Text="{Binding DateRangeLabel}" /><Span Text=" · 📍 " /><Span Text="{Binding Location}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Grid.Row="2" FontSize="11" TextColor="{DynamicResource LuxTextDim}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="👥 " /><Span Text="{Binding Members}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="＋ Add New Task" Margin="16,10" BackgroundColor="{DynamicResource LuxPrimary}" TextColor="White" FontAttributes="Bold"
                CornerRadius="12" HeightRequest="46" Command="{Binding AddTaskCommand}" />
    </Grid>
</local:LuxContentPage>
