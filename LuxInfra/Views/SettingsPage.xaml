<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{DynamicResource LuxBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="⚙️ Settings" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />

            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="📧 Daily report" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource LuxPrimarySoft}" />
                    <Label Text="Report email" FontSize="12" TextColor="{DynamicResource LuxTextDim}" />
                    <Entry Text="{Binding ReportEmail}" TextColor="{DynamicResource LuxText}" Keyboard="Email" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Auto-send at end of day" TextColor="{DynamicResource LuxText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AutoSend}" OnColor="{DynamicResource LuxAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Send time" TextColor="{DynamicResource LuxText}" VerticalOptions="Center" />
                        <TimePicker Grid.Column="1" Time="{Binding AutoSendTime}" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔐 SMTP (for automatic emails)" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource LuxPrimarySoft}" />
                    <Label Text="Optional. Without SMTP, reports open in your mail app instead. For Gmail use smtp.gmail.com + an App Password."
                           FontSize="12" TextColor="{DynamicResource LuxTextDim}" />
                    <Entry Text="{Binding SmtpHost}" Placeholder="smtp.gmail.com" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    <Entry Text="{Binding SmtpPort}" Placeholder="587" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" Keyboard="Numeric" />
                    <Entry Text="{Binding SmtpUser}" Placeholder="you@gmail.com" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" Keyboard="Email" />
                    <Entry Text="{Binding SmtpPass}" Placeholder="app password" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" IsPassword="True" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="💾 Save" Command="{Binding SaveCommand}"
                        Background="{DynamicResource LuxGradient}" TextColor="White"
                        FontAttributes="Bold" CornerRadius="14" HeightRequest="48" />
                <Button Grid.Column="1" Text="📤 Send today's report" Command="{Binding SendTestCommand}"
                        BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                        CornerRadius="14" HeightRequest="48" />
            </Grid>

            <Label Text="{Binding Status}" TextColor="{DynamicResource LuxAccent}" FontSize="13" HorizontalOptions="Center" />

            <Label Text="LuxInfra v1.0 · interior design, tracked in style 🛋️✨"
                   FontSize="11" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
