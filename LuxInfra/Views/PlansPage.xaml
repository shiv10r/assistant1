<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.PlansPage"
             x:DataType="vm:PlansViewModel"
             Title="Plans &amp; Pricing"
             BackgroundColor="{DynamicResource LuxBg}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="680">

                <Label Text="👑 Plans &amp; Pricing" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                <Label Text="{Binding CurrentPlan, StringFormat='Current plan: {0}'}" FontSize="13" TextColor="{DynamicResource LuxAccent}" />

                <!-- duration -->
                <HorizontalStackLayout Spacing="8">
                    <Button Text="1 Year" FontSize="13" CornerRadius="16" HeightRequest="34" Padding="14,4"
                            BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}" Command="{Binding SetOneYearCommand}">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsThreeYear}" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="3 Years" FontSize="13" CornerRadius="16" HeightRequest="34" Padding="14,4"
                            BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}" Command="{Binding SetThreeYearCommand}">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsThreeYear}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <!-- Gold card -->
                <Border StrokeThickness="2" Padding="16" BackgroundColor="{DynamicResource LuxSurface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Border.Stroke>
                        <SolidColorBrush Color="Transparent" />
                    </Border.Stroke>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedPlan}" Value="Gold">
                            <Setter Property="Stroke" Value="{DynamicResource LuxFab}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectGoldCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="👑 GOLD" FontSize="17" FontAttributes="Bold" TextColor="#FFD43B" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="{Binding GoldStrike}" FontSize="13" TextColor="{DynamicResource LuxTextDim}" TextDecorations="Strikethrough" VerticalOptions="Center" />
                                <Label Text="{Binding GoldPrice}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <Label Text="{Binding GoldPerMonth}" FontSize="12" TextColor="{DynamicResource LuxAccent}" />
                        <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding GoldFeatures}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="13" TextColor="{DynamicResource LuxText}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Silver card -->
                <Border StrokeThickness="2" Padding="16" BackgroundColor="{DynamicResource LuxSurface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Border.Stroke><SolidColorBrush Color="Transparent" /></Border.Stroke>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedPlan}" Value="Silver">
                            <Setter Property="Stroke" Value="{DynamicResource LuxFab}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSilverCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="🥈 SILVER" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource LuxTextDim}" />
                            <Label Text="{Binding SilverPerMonth}" FontSize="12" TextColor="{DynamicResource LuxAccent}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="{Binding SilverStrike}" FontSize="13" TextColor="{DynamicResource LuxTextDim}" TextDecorations="Strikethrough" VerticalOptions="Center" />
                            <Label Text="{Binding SilverPrice}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- comparison -->
                <Label Text="Feature comparison" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource LuxPrimarySoft}" Margin="0,8,0,0" />
                <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,70,70" Padding="14,10" BackgroundColor="{DynamicResource LuxPrimary}">
                            <Label Text="Features &amp; Details" FontSize="12" FontAttributes="Bold" TextColor="White" />
                            <Label Grid.Column="1" Text="Silver" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                            <Label Grid.Column="2" Text="Gold" FontSize="12" FontAttributes="Bold" TextColor="#FFD43B" HorizontalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comparison}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompareRow">
                                    <Grid ColumnDefinitions="*,70,70" Padding="14,8">
                                        <Label Text="{Binding Feature}" FontSize="13" TextColor="{DynamicResource LuxText}" />
                                        <Label Grid.Column="1" Text="{Binding Silver}" FontSize="13" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Gold}" FontSize="13" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding Status}" FontSize="13" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" Margin="0,0,0,10" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- sticky CTA -->
        <Button Grid.Row="1" Text="{Binding CtaLabel}" Command="{Binding PurchaseCommand}"
                BackgroundColor="{DynamicResource LuxFab}" TextColor="White" FontAttributes="Bold"
                CornerRadius="22" HeightRequest="46" Margin="16,8,16,16" />
    </Grid>
</ContentPage>
