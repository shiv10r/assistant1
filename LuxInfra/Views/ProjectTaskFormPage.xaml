<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectTaskFormPage"
             x:DataType="vm:ProjectTaskFormViewModel"
             Title="Add Task"
             BackgroundColor="{DynamicResource LuxBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="680">

            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Entry Text="{Binding Name}" Placeholder="Task Name *" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    <Picker Title="Status" ItemsSource="{Binding TaskStatusOptions}" SelectedItem="{Binding TaskStatus}"
                            TextColor="{DynamicResource LuxText}" TitleColor="{DynamicResource LuxTextDim}" />
                    <Entry Text="{Binding Members}" Placeholder="Members (comma separated)" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    <Entry Text="{Binding Location}" Placeholder="Location" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    <Entry Text="{Binding DurationDays}" Placeholder="Duration (Days) *" Keyboard="Numeric" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                        <Label Text="Start" FontSize="12" TextColor="{DynamicResource LuxTextDim}" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding StartDate}" TextColor="{DynamicResource LuxText}" />
                        <Label Grid.Column="2" Text="End" FontSize="12" TextColor="{DynamicResource LuxTextDim}" VerticalOptions="Center" />
                        <DatePicker Grid.Column="3" Date="{Binding EndDate}" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Entry Text="{Binding EstQuantity}" Placeholder="Est. Quantity" Keyboard="Numeric" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                        <Entry Grid.Column="1" Text="{Binding ProgressPercent}" Placeholder="Progress %" Keyboard="Numeric" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                    <Entry Text="{Binding Link}" Placeholder="Link (drawing, drive folder, etc.)" Keyboard="Url" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Label Text="{Binding ImageFileName}" IsVisible="{Binding HasImage}" FontSize="12" TextColor="{DynamicResource LuxAccent}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <Button Grid.Column="1" Text="📷 Add Image" FontSize="12" BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                                CornerRadius="10" HeightRequest="34" Padding="10,0" Command="{Binding PickImageCommand}" />
                        <Button Grid.Column="2" Text="✕" FontSize="12" IsVisible="{Binding HasImage}" BackgroundColor="Transparent" TextColor="{DynamicResource LuxPink}"
                                Command="{Binding RemoveImageCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Save &amp; New" Command="{Binding SaveAndNewCommand}"
                        BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                        CornerRadius="14" HeightRequest="46" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}"
                        Background="{DynamicResource LuxGradient}" TextColor="White" FontAttributes="Bold"
                        CornerRadius="14" HeightRequest="46" />
            </Grid>

            <Label Text="{Binding FormStatus}" FontSize="13" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" Margin="0,0,0,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
