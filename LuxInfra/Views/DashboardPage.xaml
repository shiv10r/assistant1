<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.DashboardPage"
             x:TypeArguments="vm:DashboardViewModel"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{DynamicResource LuxBg}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="14">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="📊 Dashboard" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                <Label Text="every rupee, tracked ✌️" FontSize="13" TextColor="{DynamicResource LuxTextDim}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="🔄" FontSize="16"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="{DynamicResource LuxSurface2}"
                    CornerRadius="20" WidthRequest="40" HeightRequest="40" />
        </Grid>

        <!-- Stat tiles -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource LuxGradient}" StrokeThickness="0" Padding="16,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="🔥 Today" FontSize="12" TextColor="{DynamicResource LuxOverlayText}" />
                    <Label Text="{Binding TodayTotal}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="🗓️ This month" FontSize="12" TextColor="{DynamicResource LuxTextDim}" />
                    <Label Text="{Binding MonthTotal}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="💎 All time" FontSize="12" TextColor="{DynamicResource LuxTextDim}" />
                    <Label Text="{Binding GrandTotal}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="📍 Active sites" FontSize="12" TextColor="{DynamicResource LuxTextDim}" />
                    <Label Text="{Binding SiteCount}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource LuxPink}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Grouped expenses -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="🛋️" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No expenses yet — tell the assistant!" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:SiteGroup">
                    <Grid ColumnDefinitions="*,Auto" Padding="4,14,4,6">
                        <Label Text="{Binding Site, StringFormat='📍 {0}'}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource LuxPrimarySoft}" />
                        <Label Grid.Column="1" Text="{Binding TotalLabel}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExpenseEntry">
                    <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="14,10" Margin="0,3">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Category}" FontSize="15" TextColor="{DynamicResource LuxText}" />
                                <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy · hh:mm tt}'}" FontSize="11" TextColor="{DynamicResource LuxTextDim}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</local:LuxContentPage>
