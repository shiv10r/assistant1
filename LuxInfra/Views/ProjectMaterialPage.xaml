<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectMaterialPage"
             x:TypeArguments="vm:ProjectMaterialViewModel"
             x:DataType="vm:ProjectMaterialViewModel"
             Title="Material"
             BackgroundColor="{DynamicResource LuxBg}">


    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="16,12,16,4">
            <Button Style="{StaticResource LuxMenuButton}" Clicked="OnFlyoutMenuClicked" />
            <Button Grid.Column="1" Style="{StaticResource LuxBackButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="2" Text="Material" Style="{StaticResource LuxPageHeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <HorizontalStackLayout Spacing="8">
                    <Button Text="Inventory" Style="{StaticResource LuxTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Inventory">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Inventory">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="Request" Style="{StaticResource LuxTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Request">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Request">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="Received" Style="{StaticResource LuxTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Received">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Received">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="Delivered" Style="{StaticResource LuxTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Delivered">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Delivered">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <!-- Inventory -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsInventoryTab}" BindableLayout.ItemsSource="{Binding Inventory}">
                    <BindableLayout.EmptyView>
                        <Label Text="No Material received in Project." FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:InventoryRow">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Material}" FontSize="14" TextColor="{DynamicResource LuxText}" />
                                    <Label Grid.Column="1" Text="{Binding QtyLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Request / Received / Delivered share the same row template -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRequestTab}" BindableLayout.ItemsSource="{Binding Requests}">
                    <BindableLayout.EmptyView>
                        <Label Text="No material requests yet." FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MaterialTxn">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding MaterialName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                        <Label FontSize="11" TextColor="{DynamicResource LuxTextDim}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding VendorName}" /><Span Text=" · " /><Span Text="{Binding VendorLocation}" /><Span Text=" · " /><Span Text="{Binding DateLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding QtyLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsReceivedTab}" BindableLayout.ItemsSource="{Binding Received}">
                    <BindableLayout.EmptyView>
                        <Label Text="No material received yet." FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MaterialTxn">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding MaterialName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                        <Label FontSize="11" TextColor="{DynamicResource LuxTextDim}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding VendorName}" /><Span Text=" · " /><Span Text="{Binding VendorLocation}" /><Span Text=" · " /><Span Text="{Binding PaymentMode}" /><Span Text=" · " /><Span Text="{Binding AmountLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding QtyLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxSuccess}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsDeliveredTab}" BindableLayout.ItemsSource="{Binding Delivered}">
                    <BindableLayout.EmptyView>
                        <Label Text="Nothing delivered/used yet." FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MaterialTxn">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding MaterialName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                        <Label Text="{Binding DateLabel}" FontSize="11" TextColor="{DynamicResource LuxTextDim}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding QtyLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxPink}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="16,10" ColumnDefinitions="*,Auto,*" ColumnSpacing="10" BackgroundColor="{DynamicResource LuxSurface}">
            <Button Text="＋ Request" BackgroundColor="Transparent" BorderColor="{DynamicResource LuxPrimary}" BorderWidth="1" TextColor="{DynamicResource LuxPrimarySoft}" CornerRadius="12" HeightRequest="42"
                    Command="{Binding RequestMaterialCommand}" />
            <Button Grid.Column="1" Text="⊕" FontSize="18" WidthRequest="42" HeightRequest="42" CornerRadius="21"
                    Background="{DynamicResource LuxGradient}" TextColor="White" Command="{Binding DeliverMaterialCommand}" />
            <Button Grid.Column="2" Text="＋ Received" BackgroundColor="{DynamicResource LuxSuccessSurface}" TextColor="White" CornerRadius="12" HeightRequest="42"
                    Command="{Binding ReceiveMaterialCommand}" />
        </Grid>
    </Grid>
</local:LuxContentPage>
