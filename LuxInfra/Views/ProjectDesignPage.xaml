<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectDesignPage"
             x:TypeArguments="vm:ProjectDesignViewModel"
             x:DataType="vm:ProjectDesignViewModel"
             Title="Design"
             BackgroundColor="{DynamicResource LuxBg}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="16,12,16,4">
            <Button Style="{StaticResource LuxMenuButton}" Clicked="OnFlyoutMenuClicked" />
            <Button Grid.Column="1" Style="{StaticResource LuxBackButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="2" Text="Design" Style="{StaticResource LuxPageHeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <HorizontalStackLayout Spacing="8">
                    <Button Text="2D Layout" Style="{StaticResource LuxTabButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="2D Layout">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="2D Layout">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="3D Layout" Style="{StaticResource LuxTabButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="3D Layout">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="3D Layout">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Text="Production Files" Style="{StaticResource LuxTabButton}" Command="{Binding SelectCategoryCommand}" CommandParameter="Production Files">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedCategory}" Value="Production Files">
                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Filtered}">
                    <BindableLayout.EmptyView>
                        <Label Text="No Design created in Project." FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:DesignFile">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                        <Label Text="{Binding DateLabel}" FontSize="11" TextColor="{DynamicResource LuxTextDim}" />
                                        <Label Text="{Binding Note}" FontSize="11" TextColor="{DynamicResource LuxTextDim}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="🖼️" FontSize="18" IsVisible="{Binding HasImage}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16" IsVisible="{Binding IsAdding}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Picker Title="Category" ItemsSource="{Binding Categories}" SelectedItem="{Binding NewCategory}"
                                TextColor="{DynamicResource LuxText}" TitleColor="{DynamicResource LuxTextDim}" />
                        <Entry Text="{Binding NewName}" Placeholder="Name *" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                        <Editor Text="{Binding NewNote}" Placeholder="Note / link" HeightRequest="60" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Label Text="{Binding ImageFileName}" IsVisible="{Binding HasImage}" FontSize="12" TextColor="{DynamicResource LuxAccent}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Text="🖼️ Add Image" FontSize="12" BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                                    CornerRadius="10" HeightRequest="34" Padding="10,0" Command="{Binding PickImageCommand}" />
                            <Button Grid.Column="2" Text="✕" FontSize="12" IsVisible="{Binding HasImage}" BackgroundColor="Transparent" TextColor="{DynamicResource LuxPink}"
                                    Command="{Binding RemoveImageCommand}" />
                        </Grid>
                        <Button Text="Save" Command="{Binding SaveCommand}"
                                Background="{DynamicResource LuxGradient}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="42" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding Status}" FontSize="12" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" Margin="0,0,0,20" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="＋ Add Design" Margin="16,10" BackgroundColor="{DynamicResource LuxPrimary}" TextColor="White" FontAttributes="Bold"
                CornerRadius="12" HeightRequest="46" Command="{Binding ToggleAddCommand}" />
    </Grid>
</local:LuxContentPage>
