<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectTransactionPage"
             x:TypeArguments="vm:ProjectTransactionViewModel"
             x:DataType="vm:ProjectTransactionViewModel"
             Title="Transaction"
             BackgroundColor="{DynamicResource LuxBg}">


    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="16,12,16,4">
            <Button Style="{StaticResource LuxMenuButton}" Clicked="OnFlyoutMenuClicked" />
            <Button Grid.Column="1" Style="{StaticResource LuxBackButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="2" Text="Transaction" Style="{StaticResource LuxPageHeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource LuxStatCard}">
                        <VerticalStackLayout Spacing="2"><Label Text="BALANCE" Style="{StaticResource LuxStatLabel}" /><Label Text="{Binding TxnBalanceLabel}" Style="{StaticResource LuxStatValue}" /></VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource LuxStatCard}">
                        <VerticalStackLayout Spacing="2"><Label Text="TOTAL IN" Style="{StaticResource LuxStatLabel}" /><Label Text="{Binding TxnTotalInLabel}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource LuxSuccess}" /></VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource LuxStatCard}">
                        <VerticalStackLayout Spacing="2"><Label Text="TOTAL OUT" Style="{StaticResource LuxStatLabel}" /><Label Text="{Binding TxnTotalOutLabel}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource LuxPink}" /></VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Txns}">
                    <BindableLayout.EmptyView>
                        <Label Text="No transactions recorded yet — use Payment In / Payment Out below." FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectTxn">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding PartyName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                        <Label FontSize="11" TextColor="{DynamicResource LuxTextDim}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding TypeLabel}" /><Span Text=" · " /><Span Text="{Binding DateLabel}" /><Span Text=" · " /><Span Text="{Binding PaymentMethod}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding AmountLabel}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsIn}" Value="True"><Setter Property="TextColor" Value="{DynamicResource LuxSuccess}" /></DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsIn}" Value="False"><Setter Property="TextColor" Value="{DynamicResource LuxPink}" /></DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding TxnStatus}" FontSize="12" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" Margin="0,0,0,20" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="16,10" BackgroundColor="{DynamicResource LuxSurface}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Payment In" BackgroundColor="{DynamicResource LuxSuccessSurface}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Command="{Binding PaymentInCommand}" />
                <Button Grid.Column="1" Text="Payment Out" BackgroundColor="{DynamicResource LuxDangerSurface}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Command="{Binding PaymentOutCommand}" />
            </Grid>
            <Button Text="⊕" FontSize="20" WidthRequest="46" HeightRequest="46" CornerRadius="23"
                    Background="{DynamicResource LuxGradient}" TextColor="White" HorizontalOptions="Center" Command="{Binding NewTransactionCommand}" />
        </Grid>
    </Grid>
</local:LuxContentPage>
