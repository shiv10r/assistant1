<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.TxnFormPage"
             x:TypeArguments="vm:TxnFormViewModel"
             x:Name="Page"
             x:DataType="vm:TxnFormViewModel"
             Title="New Transaction"
             BackgroundColor="{DynamicResource LuxBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="720">

            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Picker Title="Transaction type" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeName}"
                                TextColor="{DynamicResource LuxText}" TitleColor="{DynamicResource LuxTextDim}" />
                        <Label Grid.Column="1" Text="{Binding RefLabel}" FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource LuxAccent}" VerticalOptions="Center" />
                    </Grid>
                    <Picker Title="Select party (or type a name below)" ItemsSource="{Binding PartyChoices}" ItemDisplayBinding="{Binding Name, x:DataType={x:Type models:Party}}"
                            SelectedItem="{Binding SelectedParty}" TextColor="{DynamicResource LuxText}" TitleColor="{DynamicResource LuxTextDim}" />
                    <Entry Text="{Binding PartyNameText}" Placeholder="Customer name (default: Cash)" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                        <Label Text="Date" FontSize="12" TextColor="{DynamicResource LuxTextDim}" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding Date}" TextColor="{DynamicResource LuxText}" />
                        <Label Grid.Column="2" Text="Due" FontSize="12" TextColor="{DynamicResource LuxTextDim}" VerticalOptions="Center" />
                        <DatePicker Grid.Column="3" Date="{Binding DueDate}" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                    <Entry Text="{Binding StateOfSupply}" Placeholder="State of Supply (drives CGST/SGST vs IGST)" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                    <Picker Title="Payment mode" ItemsSource="{Binding PaymentModeOptions}" SelectedItem="{Binding PaymentMode}"
                            TextColor="{DynamicResource LuxText}" TitleColor="{DynamicResource LuxTextDim}" />
                </VerticalStackLayout>
            </Border>

            <!-- payment amount (payments only) -->
            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16" IsVisible="{Binding IsPayment}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Entry Text="{Binding PaymentAmount}" Placeholder="Amount ₹" Keyboard="Numeric" FontSize="18"
                       PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
            </Border>

            <!-- line items -->
            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16" IsVisible="{Binding IsNotPayment}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="🛒 Items" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource LuxPrimarySoft}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Lines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TxnLine">
                                <Border BackgroundColor="{DynamicResource LuxSurface2}" StrokeThickness="0" Padding="10">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,60,80,60,Auto,Auto" ColumnSpacing="6">
                                        <Picker Grid.ColumnSpan="6" Title="Pick item from catalog"
                                                ItemsSource="{Binding ItemChoices}" ItemDisplayBinding="{Binding Name, x:DataType={x:Type models:CatalogItem}}"
                                                SelectedItem="{Binding SelectedItem}"
                                                TextColor="{DynamicResource LuxText}" TitleColor="{DynamicResource LuxTextDim}" FontSize="13" />
                                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Qty}" Placeholder="Qty" Keyboard="Numeric" FontSize="13" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                                        <Entry Grid.Row="1" Grid.Column="2" Text="{Binding Rate}" Placeholder="Rate" Keyboard="Numeric" FontSize="13" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                                        <Entry Grid.Row="1" Grid.Column="3" Text="{Binding TaxPct}" Placeholder="GST%" Keyboard="Numeric" FontSize="13" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                                        <Label Grid.Row="1" Grid.Column="4" Text="{Binding AmountLabel}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" VerticalOptions="Center" />
                                        <Button Grid.Row="1" Grid.Column="5" Text="✕" FontSize="12" BackgroundColor="Transparent" TextColor="{DynamicResource LuxPink}"
                                                Command="{Binding BindingContext.RemoveLineCommand, Source={x:Reference Page}, x:DataType={x:Type ContentPage}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="＋ Add Item Row" Command="{Binding AddLineCommand}"
                            BackgroundColor="Transparent" TextColor="{DynamicResource LuxAccent}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- totals -->
            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16" IsVisible="{Binding IsNotPayment}">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Subtotal" TextColor="{DynamicResource LuxTextDim}" />
                        <Label Grid.Column="1" Text="{Binding SubtotalLabel}" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="GST" TextColor="{DynamicResource LuxTextDim}" />
                        <Label Grid.Column="1" Text="{Binding TaxLabel}" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,120">
                        <Label Text="Discount ₹" TextColor="{DynamicResource LuxTextDim}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding Discount}" Keyboard="Numeric" HorizontalTextAlignment="End" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource LuxSurface2}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="TOTAL" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                        <Label Grid.Column="1" Text="{Binding TotalLabel}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource LuxAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,120">
                        <Label Text="Received ₹" TextColor="{DynamicResource LuxTextDim}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding Received}" Keyboard="Numeric" HorizontalTextAlignment="End" TextColor="{DynamicResource LuxText}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Balance" TextColor="{DynamicResource LuxTextDim}" />
                        <Label Grid.Column="1" Text="{Binding BalanceLabel}" FontAttributes="Bold" TextColor="{DynamicResource LuxPink}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Entry Text="{Binding Description}" Placeholder="Description (optional)" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="💾 Save" Command="{Binding SaveCommand}"
                        BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                        CornerRadius="14" HeightRequest="46" />
                <Button Grid.Column="1" Text="💾 Save &amp; Print PDF" Command="{Binding SaveAndPrintCommand}"
                        Background="{DynamicResource LuxGradient}" TextColor="White" FontAttributes="Bold"
                        CornerRadius="14" HeightRequest="46" />
            </Grid>

            <Label Text="{Binding Status}" FontSize="13" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" Margin="0,0,0,20" />
        </VerticalStackLayout>
    </ScrollView>
</local:LuxContentPage>
