<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectFilesPage"
             x:TypeArguments="vm:ProjectFilesViewModel"
             x:Name="Page"
             x:DataType="vm:ProjectFilesViewModel"
             Title="Files"
             BackgroundColor="{DynamicResource LuxBg}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="16,12,16,4">
            <Button Style="{StaticResource LuxMenuButton}" Clicked="OnFlyoutMenuClicked" />
            <Button Grid.Column="1" Style="{StaticResource LuxBackButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="2" Text="Files" Style="{StaticResource LuxPageHeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="Folders" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxPrimarySoft}" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Folders}">
                    <BindableLayout.EmptyView>
                        <Label Text="No Folders added" FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,10" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectFolder">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectFolderCommand, Source={x:Reference Page}, x:DataType={x:Type ContentPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="📁" FontSize="16" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" TextColor="{DynamicResource LuxText}" Margin="8,0,0,0" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding SelectedFolder.Name, StringFormat='Files in {0}'}" IsVisible="{Binding HasSelectedFolder}"
                       FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxPrimarySoft}" Margin="0,10,0,0" />
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Files}">
                    <BindableLayout.EmptyView>
                        <Label Text="Add files in this folder" FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,10" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectFile">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="10,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="📄" FontSize="14" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding FileName}" FontSize="13" TextColor="{DynamicResource LuxText}" Margin="8,0,0,0" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="⬆ Upload File" FontSize="13" BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}"
                        CornerRadius="12" HeightRequest="40" Command="{Binding UploadFileCommand}" />

                <Label Text="{Binding Status}" FontSize="12" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" Margin="0,0,0,20" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="New Folder" Margin="16,10" BackgroundColor="{DynamicResource LuxPrimary}" TextColor="White" FontAttributes="Bold"
                CornerRadius="12" HeightRequest="46" Clicked="OnNewFolderClicked" />
    </Grid>
</local:LuxContentPage>
