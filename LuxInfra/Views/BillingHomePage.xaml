<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.BillingHomePage"
             x:TypeArguments="vm:BillingHomeViewModel"
             x:Name="Page"
             x:DataType="vm:BillingHomeViewModel"
             Title="Bills"
             BackgroundColor="{DynamicResource LuxBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- KPI cards -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Style="{StaticResource LuxCard}" Padding="12,10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="↙ You'll Get" FontSize="11" TextColor="{DynamicResource LuxSuccess}" />
                    <Label Text="{Binding YoullGet}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource LuxCard}" Padding="12,10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="↗ You'll Give" FontSize="11" TextColor="{DynamicResource LuxPink}" />
                    <Label Text="{Binding YoullGive}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource LuxCard}" Background="{DynamicResource LuxGradient}" Padding="12,10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="🔥 Sale (this month)" FontSize="11" TextColor="{DynamicResource LuxOverlayText}" />
                    <Label Text="{Binding MonthSale}" FontSize="17" FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- segmented -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="Transaction Details" Style="{StaticResource LuxSegmentButton}"
                    Command="{Binding ShowTxnsCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsTxnView}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Text="Party Details" Style="{StaticResource LuxSegmentButton}"
                    Command="{Binding ShowPartiesCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsTxnView}" Value="False">
                        <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Label Grid.Row="2" Text="{Binding Status}" FontSize="12" TextColor="{DynamicResource LuxAccent}" />

        <!-- transaction list (wrapped in Grid to prevent MAUI visibility remeasurement issues) -->
        <Grid Grid.Row="3" IsVisible="{Binding IsTxnView}">
            <CollectionView ItemsSource="{Binding Txns}">
                <CollectionView.EmptyView>
                    <Label Text="No transactions yet — tap ＋ to create your first sale 🧾" TextColor="{DynamicResource LuxTextDim}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BizTxn">
                        <Border Style="{StaticResource LuxCardCompact}" Padding="14,10" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding PartyName}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                        <Border Style="{StaticResource LuxPillBadge}" BackgroundColor="{DynamicResource LuxSuccessSurface}">
                                            <Label Text="{Binding TypeLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label FontSize="12" TextColor="{DynamicResource LuxTextDim}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding RefLabel}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding DateLabel}" />
                                                <Span Text="  Total " />
                                                <Span Text="{Binding TotalLabel}" FontAttributes="Bold" />
                                                <Span Text="  Balance " />
                                                <Span Text="{Binding BalanceLabel}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="🖨️" FontSize="15" BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.PrintTxnCommand, Source={x:Reference Page}, x:DataType={x:Type ContentPage}}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Text="📤" FontSize="15" BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.ShareTxnCommand, Source={x:Reference Page}, x:DataType={x:Type ContentPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- party list (wrapped in Grid to prevent MAUI visibility remeasurement issues) -->
        <Grid Grid.Row="3" IsVisible="{Binding IsTxnView, Converter={StaticResource InvertBool}}">
            <CollectionView ItemsSource="{Binding Parties}">
                <CollectionView.EmptyView>
                    <Label Text="No parties yet — tap ＋ to add your first customer 🤝" TextColor="{DynamicResource LuxTextDim}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Party">
                        <Border Style="{StaticResource LuxCardCompact}" Padding="14,10" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                    <Label Text="{Binding Phone}" FontSize="12" TextColor="{DynamicResource LuxTextDim}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                    <Label Text="{Binding BalanceLabel}" FontSize="15" FontAttributes="Bold" HorizontalOptions="End"
                                           TextColor="{DynamicResource LuxText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsReceivable}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource LuxSuccess}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsReceivable}" Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource LuxPink}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding BalanceDirection}" FontSize="10" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- FAB -->
        <Button Grid.Row="4" Text="{Binding FabLabel}" Command="{Binding AddNewCommand}"
                Style="{StaticResource LuxFabButton}" />
    </Grid>
</local:LuxContentPage>
