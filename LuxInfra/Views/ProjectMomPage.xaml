<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:models="clr-namespace:LuxInfra.Models;assembly=LuxInfra.Core"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectMomPage"
             x:TypeArguments="vm:ProjectMomViewModel"
             x:DataType="vm:ProjectMomViewModel"
             Title="MOM"
             BackgroundColor="{DynamicResource LuxBg}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="16,12,16,4">
            <Button Style="{StaticResource LuxMenuButton}" Clicked="OnFlyoutMenuClicked" />
            <Button Grid.Column="1" Style="{StaticResource LuxBackButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="2" Text="MOM" Style="{StaticResource LuxPageHeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Minutes}">
                    <BindableLayout.EmptyView>
                        <Label Text="No MOM created" FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MeetingMinute">
                            <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                        <Label Grid.Column="1" Text="{Binding DateLabel}" FontSize="11" TextColor="{DynamicResource LuxTextDim}" />
                                    </Grid>
                                    <Label Text="{Binding Attendees, StringFormat='👥 {0}'}" FontSize="11" TextColor="{DynamicResource LuxTextDim}" />
                                    <Label Text="{Binding Notes}" FontSize="12" TextColor="{DynamicResource LuxText}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="16" IsVisible="{Binding IsAdding}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Entry Text="{Binding NewTitle}" Placeholder="Meeting Title *" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                        <DatePicker Date="{Binding NewDate}" TextColor="{DynamicResource LuxText}" />
                        <Entry Text="{Binding NewAttendees}" Placeholder="Attendees (comma separated)" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                        <Editor Text="{Binding NewNotes}" Placeholder="Notes" HeightRequest="80" PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                        <Button Text="Save MOM" Command="{Binding SaveCommand}"
                                Background="{DynamicResource LuxGradient}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="42" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding Status}" FontSize="12" TextColor="{DynamicResource LuxAccent}" HorizontalOptions="Center" Margin="0,0,0,20" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="＋ New MOM" Margin="16,10" BackgroundColor="{DynamicResource LuxPrimary}" TextColor="White" FontAttributes="Bold"
                CornerRadius="12" HeightRequest="46" Command="{Binding ToggleAddCommand}" />
    </Grid>
</local:LuxContentPage>
