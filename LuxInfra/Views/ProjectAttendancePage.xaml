<?xml version="1.0" encoding="utf-8" ?>
<local:LuxContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LuxInfra.Views"
             xmlns:vm="clr-namespace:LuxInfra.ViewModels"
             x:Class="LuxInfra.Views.ProjectAttendancePage"
             x:TypeArguments="vm:ProjectAttendanceViewModel"
             x:DataType="vm:ProjectAttendanceViewModel"
             Title="Attendance"
             BackgroundColor="{DynamicResource LuxBg}">

    <ContentPage.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource LuxSurface}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="12" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="StatLabel" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextColor" Value="{DynamicResource LuxTextDim}" />
        </Style>
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource LuxText}" />
        </Style>
        <Style x:Key="StatusChip" TargetType="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BackgroundColor" Value="{DynamicResource LuxSurface2}" />
            <Setter Property="TextColor" Value="{DynamicResource LuxTextDim}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="16,12,16,4">
            <Button Style="{StaticResource LuxMenuButton}" Clicked="OnFlyoutMenuClicked" />
            <Button Grid.Column="1" Style="{StaticResource LuxBackButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="2" Text="Attendance" Style="{StaticResource LuxPageHeaderTitle}" />
        </Grid>
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="16" Spacing="12">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="◀" FontSize="14" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                        BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}" Command="{Binding PrevDayCommand}" />
                <Label Grid.Column="1" Text="{Binding DateLabel}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource LuxText}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="▶" FontSize="14" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                        BackgroundColor="{DynamicResource LuxSurface2}" TextColor="{DynamicResource LuxText}" Command="{Binding NextDayCommand}" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Style="{StaticResource StatCard}"><VerticalStackLayout Spacing="1"><Label Text="REGISTERED" Style="{StaticResource StatLabel}" /><Label Text="{Binding RegisteredCount}" Style="{StaticResource StatValue}" /></VerticalStackLayout></Border>
                <Border Grid.Column="1" Style="{StaticResource StatCard}"><VerticalStackLayout Spacing="1"><Label Text="UPCOMING" Style="{StaticResource StatLabel}" /><Label Text="{Binding UpcomingCount}" Style="{StaticResource StatValue}" /></VerticalStackLayout></Border>
                <Border Grid.Column="2" Style="{StaticResource StatCard}"><VerticalStackLayout Spacing="1"><Label Text="PRESENT" Style="{StaticResource StatLabel}" /><Label Text="{Binding PresentCount}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource LuxSuccess}" /></VerticalStackLayout></Border>
                <Border Grid.Column="3" Style="{StaticResource StatCard}"><VerticalStackLayout Spacing="1"><Label Text="ABSENT" Style="{StaticResource StatLabel}" /><Label Text="{Binding AbsentCount}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource LuxPink}" /></VerticalStackLayout></Border>
            </Grid>

            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
                <BindableLayout.EmptyView>
                    <Label Text="No payroll added — add site staff from the Party card first." FontSize="12" TextColor="{DynamicResource LuxTextDim}" HorizontalOptions="Center" Margin="0,20" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AttendanceRow">
                        <Border BackgroundColor="{DynamicResource LuxSurface}" StrokeThickness="0" Padding="12,10">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Party.Name}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource LuxText}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="60,Auto">
                                        <Entry Text="{Binding HoursText}" Placeholder="Hrs" Keyboard="Numeric" FontSize="12"
                                               PlaceholderColor="{DynamicResource LuxTextDim}" TextColor="{DynamicResource LuxText}" />
                                        <Button Grid.Column="1" Text="💾" FontSize="12" BackgroundColor="Transparent" Command="{Binding SaveHoursCommand}" />
                                    </Grid>
                                </Grid>
                                <HorizontalStackLayout Spacing="6">
                                    <Button Text="Registered" Style="{StaticResource StatusChip}" Command="{Binding SetStatusCommand}" CommandParameter="Registered">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Registered">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Upcoming" Style="{StaticResource StatusChip}" Command="{Binding SetStatusCommand}" CommandParameter="Upcoming">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Upcoming">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Present" Style="{StaticResource StatusChip}" Command="{Binding SetStatusCommand}" CommandParameter="Present">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Present">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxSuccessSurface}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                                    </Button>
                                    <Button Text="Absent" Style="{StaticResource StatusChip}" Command="{Binding SetStatusCommand}" CommandParameter="Absent">
                                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Absent">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource LuxDangerSurface}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</local:LuxContentPage>
