<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- LuxInfra brand palette. Values here are the "Dark" theme defaults;
         ThemeService.Apply() overwrites all of these at runtime when the
         user switches theme (Dark/Light/Protan/Deutan/Tritan). -->
    <Color x:Key="LuxBg">#0F0F1A</Color>
    <Color x:Key="LuxSurface">#1C1C2E</Color>
    <Color x:Key="LuxSurface2">#26263C</Color>
    <Color x:Key="LuxPrimary">#7C4DFF</Color>
    <Color x:Key="LuxPrimarySoft">#B39DFF</Color>
    <Color x:Key="LuxAccent">#00E5C3</Color>
    <Color x:Key="LuxPink">#FF5C8A</Color>
    <Color x:Key="LuxText">#F2F2F7</Color>
    <Color x:Key="LuxTextDim">#9A9AB0</Color>

    <!-- Semantic keys added to replace hardcoded hex literals that used to
         bypass ThemeService, so color-blind modes now apply everywhere. -->
    <Color x:Key="LuxSuccess">#37B24D</Color>
    <Color x:Key="LuxSuccessSurface">#1D6F42</Color>
    <Color x:Key="LuxDangerSurface">#8B1E3F</Color>
    <Color x:Key="LuxFab">#E5484D</Color>
    <Color x:Key="LuxOverlayText">#CCFFFFFF</Color>

    <LinearGradientBrush x:Key="LuxGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C4DFF" Offset="0.0" />
        <GradientStop Color="#00B8D9" Offset="0.6" />
        <GradientStop Color="#00E5C3" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
