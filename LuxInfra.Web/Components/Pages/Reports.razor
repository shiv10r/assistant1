@page "/reports"
@rendermode InteractiveServer
@using LuxInfra.Models
@using LuxInfra.Services
@inject DatabaseService Db
@inject ReportService ReportSvc

<PageTitle>LuxInfra · Reports</PageTitle>

<div class="page-head">
    <div>
        <h1>📑 Reports</h1>
        <div class="muted">@(_report?.PeriodLabel)</div>
    </div>
    <div class="total-badge">
        <div class="amount">@(_report?.TotalLabel ?? "₹0")</div>
        <div class="entries">@(_report?.Count ?? 0) entries</div>
    </div>
</div>

<div class="card">
    <div class="periods">
        @foreach (var p in new[] { ReportPeriod.Today, ReportPeriod.Week, ReportPeriod.Month, ReportPeriod.All })
        {
            <button class="@(_period == p ? "active" : "")" @onclick="() => SetPeriod(p)">@PeriodName(p)</button>
        }
    </div>

    <div class="downloads">
        <a class="dl excel" href="/export/xlsx?period=@_period" target="_blank">📊 Excel</a>
        <a class="dl pdf" href="/export/pdf?period=@_period" target="_blank">📄 PDF</a>
        <a class="dl png" href="/export/png?period=@_period" target="_blank">🖼️ PNG</a>
    </div>

    @if (_report is null || _report.Count == 0)
    {
        <div class="empty">🛋️ No expenses for this period — tell the assistant!</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="main-table">
                <thead><tr><th>Date</th><th>Site</th><th>Client</th><th>Category</th><th class="num">Amount</th></tr></thead>
                <tbody>
                    @foreach (var r in _report.Rows)
                    {
                        <tr>
                            <td class="muted">@r.DateLabel</td>
                            <td>@r.Site</td>
                            <td class="muted">@r.Client</td>
                            <td class="cat">@r.Category</td>
                            <td class="num">@r.AmountLabel</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><td colspan="4">TOTAL</td><td class="num total">@_report.TotalLabel</td></tr></tfoot>
            </table>

            <h3>By category</h3>
            <table class="main-table">
                <thead><tr><th>Category</th><th>Entries</th><th class="num">Total</th></tr></thead>
                <tbody>
                    @foreach (var c in _report.CategoryTotals)
                    {
                        <tr><td class="cat">@c.Category</td><td class="muted">@c.Count</td><td class="num">@c.TotalLabel</td></tr>
                    }
                </tbody>
            </table>

            <h3>By site</h3>
            <table class="main-table">
                <thead><tr><th>Site</th><th>Entries</th><th class="num">Total</th></tr></thead>
                <tbody>
                    @foreach (var s in _report.SiteTotals)
                    {
                        <tr><td class="cat">@s.Category</td><td class="muted">@s.Count</td><td class="num">@s.TotalLabel</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private ReportPeriod _period = ReportPeriod.Today;
    private ReportData? _report;

    protected override async Task OnInitializedAsync() => await RefreshReport();

    private static string PeriodName(ReportPeriod p) => p switch
    {
        ReportPeriod.Today => "Today",
        ReportPeriod.Week => "7 days",
        ReportPeriod.Month => "Month",
        _ => "All time"
    };

    private async Task SetPeriod(ReportPeriod p)
    {
        _period = p;
        await RefreshReport();
    }

    private async Task RefreshReport() => _report = await ReportSvc.BuildReportAsync(_period);
}
