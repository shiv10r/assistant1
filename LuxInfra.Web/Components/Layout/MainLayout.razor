@inherits LayoutComponentBase

<div class="app">
    <!-- ===== TOP BAR ===== -->
    <header class="topbar">
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">☰</button>
        <div class="logo-mark">
            <svg viewBox="0 0 456 456" width="34" height="34">
                <defs>
                    <linearGradient id="luxTop" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#7C4DFF"/><stop offset="0.6" stop-color="#00B8D9"/><stop offset="1" stop-color="#00E5C3"/>
                    </linearGradient>
                </defs>
                <rect width="456" height="456" rx="100" fill="url(#luxTop)"/>
                <path d="M120 210 L228 120 L336 210" fill="none" stroke="#FFF" stroke-width="30" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M178 206 V330 H300" fill="none" stroke="#FFF" stroke-width="38" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="318" cy="228" r="17" fill="#0F0F1A"/>
            </svg>
        </div>
        <div class="brand">Lux<span>Infra</span></div>
        <div class="online">● online</div>
    </header>

    <div class="body-row">

    <!-- ===== SIDEBAR (hamburger menu) ===== -->
    <nav class="sidebar @(_open ? "open" : "")">
        <div class="nav-group">
            <div class="group-label">🤖 My Assistant</div>
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">💬 Assistant</NavLink>
            <NavLink class="nav-item" href="/dashboard">📊 Dashboard</NavLink>
            <NavLink class="nav-item" href="/reports">📑 Reports</NavLink>
            <NavLink class="nav-item" href="/settings">⚙️ Settings</NavLink>
        </div>
        <div class="nav-group">
            <div class="group-label">🧾 Billing</div>
            <NavLink class="nav-item" href="/billing">🧾 Billing</NavLink>
        </div>
        <div class="nav-group">
            <div class="group-label">🏗️ Projects</div>
            <NavLink class="nav-item" href="/projects">🏗️ Projects</NavLink>
        </div>
        <div class="nav-group">
            <div class="group-label">Account</div>
            <NavLink class="nav-item" href="/plans">👑 Plans &amp; Pricing</NavLink>
            <NavLink class="nav-item" href="/account">👤 My Account</NavLink>
        </div>
    </nav>
    @if (_open)
    {
        <div class="backdrop" @onclick="CloseMenu"></div>
    }

    <main class="content">
        @Body
    </main>

    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _open;
    private void ToggleMenu() => _open = !_open;
    private void CloseMenu() => _open = false;
}